# Copy to .env and adjust. Defaults in docker-compose.yml match these values,
# so the stack runs even with no .env at all.

# ---- credentials (guest access is always disabled) ----
SMB_USER=testuser
SMB_PASS=testpass

# ---- share ----
SMB_SHARE=testshare

# ---- ports ----
# SMB_HOST_PORT: published on the host, this is what clients dial.
#   Use 1445 (or anything free) on Windows hosts, or on any host already
#   running Samba. Note that the Windows SMB *client* cannot dial a
#   non-445 port - see README.
# SMB_PORT: the port smbd listens on inside the container. Only worth
#   changing when running with --network host, or to test client behaviour
#   against a non-standard SMB port. Accepts a list, e.g. "445 1445".
SMB_HOST_PORT=445
SMB_PORT=445

# ---- protocol range under test ----
# Valid: NT1 (SMB1, legacy only), SMB2, SMB2_02, SMB2_10, SMB3, SMB3_11
SMB_MIN_PROTOCOL=SMB2
SMB_MAX_PROTOCOL=SMB3

# ntlmv2-only | yes | no  -- may need "yes" if you set SMB_MIN_PROTOCOL=NT1
SMB_NTLM_AUTH=ntlmv2-only

# ---- identity ----
SMB_WORKGROUP=WORKGROUP
SMB_NETBIOS_NAME=SMBTEST

# ---- misc ----
# UID for the container user. Only matters if you bind-mount your own folder
# over /share and it is not world-readable; the baked-in share is.
SMB_UID=1000

# 0-10. Raise to 3 to see per-request protocol detail in `docker logs`.
SMB_LOG_LEVEL=1

# ---- baked-in test files (build time, not run time) ----
# These are build args, so they take effect on `docker compose build`, not on a
# restart. See README for what each fixture directory holds.
# FIXTURE_LARGE_MB: big incompressible file, in MiB. Random data, so it adds its
#   full size to the image. 0 omits it.
# FIXTURE_SPARSE_MB: sparse file, in MiB. Nearly free in the image but reads
#   back as real bytes - use this for multi-GB transfer tests. 0 omits it.
# FIXTURE_MANY_FILES: entries in many-files/, for directory enumeration.
# FIXTURE_DEEP_LEVELS: depth of deep-path/, for path-length limits.
# FIXTURE_HOSTILE_NAMES: 1 adds filenames that are legal on Linux and illegal
#   on Windows. Off by default - some clients handle them badly enough to
#   obscure whatever you were actually testing.
FIXTURE_LARGE_MB=10
FIXTURE_SPARSE_MB=0
FIXTURE_MANY_FILES=256
FIXTURE_DEEP_LEVELS=20
FIXTURE_HOSTILE_NAMES=0
