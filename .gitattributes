# Shell scripts and Samba config must be LF or the container fails to start.
* text=auto eol=lf
*.sh text eol=lf
*.tmpl text eol=lf
Dockerfile text eol=lf

# Test fixtures whose exact bytes are the point. Without -text the line-ending
# normalisation above would quietly rewrite them and the fixture would stop
# testing anything.
share/text/crlf.txt -text
share/text/no-trailing-newline.txt -text
